{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "▶ Run Website (app.py)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/app.py",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "▶ Run Website (web/app.py)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/web/app.py",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "▶ Run Website (wsgi.py)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/wsgi.py",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Python: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ]
}
